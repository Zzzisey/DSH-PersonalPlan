{
  "name": "@local/planner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Personal Planner for DeepSeek Harness: cross-session goal -> phase -> daily task planning.",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": {
    "generate-build-info": "node scripts/generate-build-info.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "npm run clean && npm run generate-build-info",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "precheck": "npm run generate-build-info",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run generate-build-info",
    "test": "node --experimental-strip-types --import ./test/helpers/registerTypeScriptLoader.mjs --test test/*.test.ts"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "typescript": "^5.9.0"
  },
  "engines": { "node": ">=24" }
}
